# ─────────────────────────────────────────────────────────────
# SiteGuard environment. Copy to `.env` (repo root) and fill in.
# The same file is used by web, worker and docker-compose.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
APP_URL=https://monitor.mycompany.com
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string
TIMEZONE=Asia/Kolkata
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────
# Local dev (pnpm dev:db → own mongod on 27027, no auth, bound to 127.0.0.1):
MONGODB_URI=mongodb://127.0.0.1:27027/siteguard?directConnection=true
# Production (docker-compose, internal network only):
# MONGODB_URI=mongodb://siteguard:APP_PASSWORD@mongo:27017/siteguard?replicaSet=rs0&authSource=siteguard

# Used only by docker-compose to create the users on first boot
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me-root
MONGO_APP_DB=siteguard
MONGO_APP_USER=siteguard
MONGO_APP_PASSWORD=change-me-app

# ── Google PageSpeed Insights ───────────────────────────────
PSI_API_KEY=

# ── Alert delivery mode ─────────────────────────────────────
# true  = PREVIEW: nothing is sent; every email/Telegram message is rendered and
#         stored for /dev/emails and /dev/telegram (safe without any accounts).
# false = LIVE: really send (each channel still stays in preview while its keys are missing).
DRY_RUN=true

# ── Email (Brevo free plan: 300/day) ────────────────────────
BREVO_API_KEY=
ALERT_FROM_EMAIL=alerts@mycompany.com
ALERT_FROM_NAME=SiteGuard
# Comma-separated
ALERT_TO_EMAILS=team@mycompany.com
# Hard ceiling we allow ourselves per day, and how many of those are
# always reserved for the morning/night reports.
EMAIL_DAILY_LIMIT=250
EMAIL_RESERVED_FOR_REPORTS=10

# ── Telegram ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# One or more chat IDs, comma-separated (personal chat, group “-100…”, channel)
TELEGRAM_CHAT_ID=

# ── Worker ──────────────────────────────────────────────────
# External dead-man's switch (e.g. Healthchecks.io ping URL). Optional.
HEARTBEAT_PING_URL=
# Where Playwright screenshots are stored (mounted volume in prod)
SCREENSHOT_DIR=./.dev-data/screenshots

# ── Reverse proxy (Caddy) ───────────────────────────────────
APP_DOMAIN=monitor.mycompany.com
ACME_EMAIL=alerts@mycompany.com
