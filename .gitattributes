# Normalize all text files to LF in the repo and working tree (prod is Linux arm64).
* text=auto eol=lf

# Must be LF or they break on the server
*.sh        text eol=lf
*.js        text eol=lf
Caddyfile   text eol=lf
Dockerfile* text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.conf      text eol=lf
.env*       text eol=lf

# Windows-only scripts
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.gz   binary
*.woff2 binary
